# ==============================================================================
# CLOUD KITCHEN PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Public Keys (Available in Browser and Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Secret Keys (Server-side ONLY - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth / Auth.js Configuration
AUTH_SECRET=cloud_kitchen_super_secret_session_token_min_32_chars
NEXTAUTH_SECRET=cloud_kitchen_super_secret_session_token_min_32_chars
AUTH_URL=http://localhost:3000

# Payment Gateway Configuration
# Mode: "demo" (simulated UPI payment) or "production" (Razorpay)
PAYMENT_MODE=demo

# Razorpay Keys (Server-side ONLY for secret keys)
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourkeyid
